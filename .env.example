# NETRA — Cyber Crime OSINT & Intelligence System
# Configuration & Optional API Keys
#
# The project works with ZERO keys set — phone lookup uses the offline
# `phonenumbers` library and email breach-check uses the free, keyless
# XposedOrNot API. Everything below is OPTIONAL enrichment only.

# Optional: adds live carrier/VOIP confirmation on top of offline data.
# NumVerify free tier: https://numverify.com/ (limited free requests/month)
NUMVERIFY_API_KEY=

# Optional: cross-validates XposedOrNot's breach result against HIBP too.
# HIBP API is paid (~$4.39/mo as of 2026): https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Optional: emailrep.io works with NO key at a limited free rate. Get a free
# key only if you need a higher rate limit: https://emailrep.io/
EMAILREP_API_KEY=

# Optional (but strongly recommended): GitHub personal access token.
# Used by two modules:
#   1. github_code_search — raises the API rate limit from 10 to 30 req/min.
#   2. firebase_pentest   — REQUIRED for Firebase database discovery via GitHub
#      code search. Without this token, Firebase discovery is silently skipped.
# Free token, no special scopes needed: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Firebase Pentest (modules/firebase_pentest.py) ───────────────────────────
# IMPORTANT: Only use Firebase recon against targets you have EXPLICIT WRITTEN
# AUTHORIZATION to test. Unauthorized database access is illegal.
#
# Firebase recon runs automatically during email investigation when:
#   1. The email domain is a custom domain (not gmail/yahoo/etc.)
#   2. GITHUB_TOKEN is set (required for GitHub discovery phase)
#
# You can also run it standalone:
#   python -m modules.firebase_pentest --identifier suspect@example.com
#   python -m modules.firebase_pentest --url https://myproject.firebaseio.com
